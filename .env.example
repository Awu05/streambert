# Settings for the Docker image. Copy this file to `.env` (next to
# docker-compose.yml) and edit it. Docker Compose reads `.env` automatically;
# it is ignored by git, so the password stays on your machine.

# Required. The password you sign in with.
STREAMBERT_PASSWORD=

# Port on the host for http://<server>:<port>
STREAMBERT_WEB_PORT=8080

# Provider pages used at once to find streams. Further requests wait in a queue.
# 2 suits a Raspberry Pi; raise it on a bigger server.
STREAMBERT_MAX_HIDDEN_PAGES=2

# 1 = limit memory use (also limits Chromium to 3 renderer processes).
# Set 0 if you raise STREAMBERT_MAX_HIDDEN_PAGES above 2.
STREAMBERT_LOW_RAM=1

# User and group that own ./config and ./downloads on the host (`id -u`, `id -g`)
PUID=1000
PGID=1000
TZ=Etc/UTC
